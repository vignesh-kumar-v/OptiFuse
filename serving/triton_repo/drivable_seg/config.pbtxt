# Drivable-area + lane-marking segmentation. SegFormer-B0 fine-tuned on Waymo
# panoptic labels, FP16 TensorRT engine.
# Shapes/dtypes verified against the exported ONNX graph:
#   input  "pixel_values" FP16  [1, 3, 640, 960]   plain 0-1 RGB
#   output "class_map"    UINT8 [1, 640, 960]      0=background 1=road 2=marking 3=sidewalk
#
# The graph bakes in ImageNet normalization and the upsample+argmax, so the
# client sends plain 0-1 RGB and receives a finished class map -- 614KB instead
# of the 9.8MB of float32 logits the raw head would emit.
name: "drivable_seg"
platform: "tensorrt_plan"

# Batch dimension is baked into the engine as a literal 1, so Triton must not
# prepend its own. max_batch_size: 0 means "dims below are the complete shape".
max_batch_size: 0

input [
  {
    name: "pixel_values"
    data_type: TYPE_FP16
    dims: [ 1, 3, 640, 960 ]
  }
]
output [
  {
    name: "class_map"
    data_type: TYPE_UINT8
    dims: [ 1, 640, 960 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]
