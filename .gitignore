# Waymo dataset (huge tfrecords) + generated viewers
/waymo_perception/
*_viewer.html
*.tfrecord

# Extracted training shards (waymo_extract.py output)
/cache/
*.tar

# Generated ML pipeline artifacts (regenerable from source + downloaded data)
/data/datasets/
/models/*/runs/
# Pretrained base checkpoints -- auto-downloaded on first train.py run
/models/detection/*.pt
/serving/triton_repo/*/[0-9]*/
/serving/build_engine*.log
# Client output viewers, whatever --out name was used -- keep the hand-authored
# templates (which are source, not generated).
/serving/*.html
!/serving/viewer_template.html
!/serving/multimodel_viewer.html

# Python
__pycache__/
*.py[cod]
.venv/

# Tools
.claude
